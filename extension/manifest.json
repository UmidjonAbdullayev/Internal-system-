{
  "manifest_version": 3,
  "name": "Internal Sys — Amazon Relay Sync",
  "version": "1.0.0",
  "description": "Sync Amazon Relay load and payment data into Internal Sys CRM via Supabase Edge Functions.",
  "permissions": ["storage", "tabs", "alarms", "scripting", "notifications"],
  "host_permissions": [
    "https://relay.amazon.com/*",
    "https://*.relay.amazon.com/*",
    "https://iiyqkdjwxlnfqvlidbqr.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Relay Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://relay.amazon.com/*", "https://*.relay.amazon.com/*"],
      "js": ["content/relay-collector.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
