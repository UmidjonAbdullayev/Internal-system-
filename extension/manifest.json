{
  "manifest_version": 3,
  "name": "Internal Sys — Amazon Relay Sync",
  "version": "1.8.0",
  "description": "Per-tab entitiesV2 filter bodies (no tileCountTab-only swap); HISTORY 7-day windows; section safety.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://relay.amazon.com/*",
    "https://*.relay.amazon.com/*",
    "https://iiyqkdjwxlnfqvlidbqr.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Relay Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://relay.amazon.com/*", "https://*.relay.amazon.com/*"],
      "js": ["content/injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://relay.amazon.com/*", "https://*.relay.amazon.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
